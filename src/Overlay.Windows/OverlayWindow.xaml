<Window x:Class="Overlay.Windows.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Translation overlay" Width="650" Height="210" MinWidth="300" MinHeight="140"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
 ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" IsHitTestVisible="False"
 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
 <Border x:Name="Panel" Background="#E010172A" BorderBrush="#64748B" BorderThickness="1" CornerRadius="10" Padding="16,10,16,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="Transparent" MouseLeftButtonDown="DragHeader" Padding="0,0,0,8">
    <TextBlock x:Name="ModeLabel" Text="等待翻译" Foreground="#93C5FD" FontSize="12"/>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="ChineseText" FontSize="26" Foreground="White" TextWrapping="Wrap"
       Text=""/>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>

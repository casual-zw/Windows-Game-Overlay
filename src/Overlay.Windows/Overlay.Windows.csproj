<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/game-overlay-logo.ico</ApplicationIcon>
    <AssemblyName>GameOverlay</AssemblyName>
    <RootNamespace>Overlay.Windows</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Overlay.Core/Overlay.Core.csproj" />
    <ProjectReference Include="../Overlay.Ocr/Overlay.Ocr.csproj" />
    <!-- Direct reference imports the package's build/publish model-copy targets. -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>
</Project>

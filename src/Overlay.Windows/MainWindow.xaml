<Window x:Class="Overlay.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Game Overlay · Luna translation" Width="1080" Height="950" MinWidth="780" MinHeight="650"
 Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Game translation overlay" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Read English locally and translate with Luna. Enable Auto for continuous detection."
              Margin="0,6,0,16" Foreground="#475569"/>
  </StackPanel>
  <DockPanel Grid.Row="1">
   <Button DockPanel.Dock="Right" Content="Test window" Click="OpenTestWindow"/>
   <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshWindows"/>
   <ComboBox x:Name="WindowList" DisplayMemberPath="Label" Margin="0,0,12,8" VerticalContentAlignment="Center"
             ToolTip="Select an open window. Restore minimized windows before starting."/>
  </DockPanel>
  <WrapPanel Grid.Row="2">
   <Button x:Name="StartButton" Content="Start capture" Click="StartCapture"/>
   <Button x:Name="StopButton" Content="Stop" Click="StopCapture" IsEnabled="False"/>
   <Button Content="In-game controls · Ctrl+Alt+O" Click="ToggleControls"/>
   <Button Content="Select on game · Ctrl+Alt+R" Click="SelectOnGame"/>
   <Button Content="Show / hide · Ctrl+Alt+T" Click="ToggleOverlay"/>
   <Button x:Name="EditButton" Content="Edit position · Ctrl+Alt+E" Click="ToggleEdit"/>
   <Button x:Name="ReadButton" Content="Read again · Ctrl+Alt+G" Click="ReadAgain" IsEnabled="False"/>
   <Button Content="Reset position" Click="ResetOverlay"/>
  </WrapPanel>
  <Grid Grid.Row="3" Margin="0,6,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Window preview · drag a rectangle around the dialogue" Margin="0,0,0,8" FontWeight="SemiBold"/>
    <Grid Grid.Row="1" Background="#111827" ClipToBounds="True">
     <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False"/>
     <Canvas x:Name="SelectionCanvas" Background="Transparent" MouseLeftButtonDown="BeginSelection"
             MouseMove="MoveSelection" MouseLeftButtonUp="EndSelection" SizeChanged="PreviewResized"
             LostMouseCapture="SelectionCaptureLost">
      <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Stroke="#38BDF8" StrokeThickness="2" Fill="#3038BDF8" IsHitTestVisible="False"/>
     </Canvas>
    </Grid>
   </Grid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Selected region" Margin="0,0,0,8" FontWeight="SemiBold"/>
    <Border Grid.Row="1" Background="#111827" Padding="4"><Image x:Name="CropImage" Stretch="Uniform"/></Border>
    <TextBlock x:Name="RegionInfo" Grid.Row="2" Text="Start capture, then select a region." Margin="0,8,0,0" Foreground="#475569"/>
   </Grid>
  </Grid>
  <Grid Grid.Row="4" Margin="0,0,0,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Recognized English · source text" FontWeight="SemiBold"/>
   <TextBox x:Name="OcrText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6"/>
   <TextBlock x:Name="OcrStatus" Grid.Row="2" Text="Finish selecting a region to read it automatically." TextWrapping="Wrap" Foreground="#475569"/>
  </Grid>
  <Grid Grid.Row="5" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Chinese font size"/>
    <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="48" Value="26" TickFrequency="2" ValueChanged="OverlayStyleChanged"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='Panel background opacity: {0:P0}'}"/>
    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="0.88" SmallChange="0.01" LargeChange="0.1"
            TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OverlayStyleChanged"
            ToolTip="0% = transparent background; 100% = solid background. Text stays visible."/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="6">
   <WrapPanel Margin="0,0,0,6">
    <Button Content="Translation settings…" Click="OpenTranslationSettings"/>
    <CheckBox x:Name="EnableTranslation" Content="Enable translation" Margin="8" Checked="TranslationOptionsChanged" Unchecked="TranslationOptionsChanged"/>
    <CheckBox x:Name="AutoRead" Content="Auto read" Margin="8" Checked="TranslationOptionsChanged" Unchecked="TranslationOptionsChanged"/>
    <TextBlock Text="Target:" VerticalAlignment="Center" Margin="8,0"/>
    <ComboBox x:Name="TargetLanguageBox" DisplayMemberPath="DisplayName" Width="165" SelectionChanged="TranslationOptionsChanged"/>
   </WrapPanel>
   <TextBlock x:Name="TranslationStatus" Text="Translation disabled. Add your key in Translation settings." TextWrapping="Wrap"/>
   <TextBlock x:Name="UsageText" TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,4,0,8"/>

   <TextBlock x:Name="StatusText" Text="Choose a game window, or open the built-in test window." FontWeight="SemiBold"/>
   <TextBlock x:Name="DiagnosticText" Margin="0,5,0,0" Foreground="#475569"/>
   <TextBlock x:Name="WarningText" Margin="0,5,0,0" Foreground="#9A3412"/>
   <TextBlock Text="Reading mode passes clicks through. Edit mode lets you drag the panel header and resize its edges. The panel hides when you switch to another app."
              Margin="0,8,0,0" Foreground="#475569" FontSize="12"/>
  </StackPanel>
 </Grid>
</Window>
